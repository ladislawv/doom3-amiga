+/*
+================
+EntityIntersectsView
+
+True if the entity's bounding sphere may be inside the view's frustum
+(g_animLOD; port, patch 0021, from ldhewm3-rearmed)
+================
+*/
+static bool EntityIntersectsView( const renderEntity_t &entity, const renderView_t &view ) {
+	const idVec3 center = entity.origin + entity.bounds.GetCenter() * entity.axis;
+	const idVec3 offset = center - view.vieworg;
+	const float radius = entity.bounds.GetRadius( entity.bounds.GetCenter() );
+	const float forward = offset * view.viewaxis[0];
+	if ( forward + radius <= 0.0f ) {
+		return false;
+	}
+	const float depth = forward > 0.0f ? forward : 0.0f;
+	const float horizontal = idMath::Fabs( offset * view.viewaxis[1] );
+	const float vertical = idMath::Fabs( offset * view.viewaxis[2] );
+	return horizontal - radius <= depth * idMath::Tan16( DEG2RAD( view.fov_x * 0.5f ) ) &&
+		vertical - radius <= depth * idMath::Tan16( DEG2RAD( view.fov_y * 0.5f ) );
+}
+
+/*
+================
+idEntity::AnimationLODInterval
+
+How often an entity at this distance from the view is animated (g_animLOD):
+every 96 ms from 768 units, 64 ms from 512, else every game tic (32 ms for
+the actors, the player apart: a tic at 30 Hz). An entity bound to another
+counts as that one.
+================
+*/
+int idEntity::AnimationLODInterval( const idVec3 &viewOrigin ) const {
+	if ( renderEntity.weaponDepthHack ) {
+		return 0;
+	}
+	const idEntity *lodEntity = GetBindMaster();
+	if ( !lodEntity ) {
+		lodEntity = this;
+	}
+	const bool actorLOD = lodEntity->IsType( idActor::Type ) && !lodEntity->IsType( idPlayer::Type );
+	const float distanceSqr = ( renderEntity.origin - viewOrigin ).LengthSqr();
+	if ( distanceSqr >= 768.0f * 768.0f ) {
+		return 96;
+	}
+	if ( distanceSqr >= 512.0f * 512.0f ) {
+		return 64;
+	}
+	return actorLOD ? 32 : 0;
+}
