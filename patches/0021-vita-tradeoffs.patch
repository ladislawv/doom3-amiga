+	// port (patch 0021, from ldhewm3-rearmed's Vita port): an animated model's
+	// surface changes every frame, and culling its triangles to the light (facing
+	// and light volume, per triangle) costs more on this CPU than drawing them
+	// all: the light surface is the whole ambient surface. The falloff and
+	// projection textures are dark outside the light, and back faces are in the
+	// model's own stencil shadow.
+	if ( !r_cullDynamicLightTris.GetBool() && ent->parms.hModel != NULL &&
+			ent->parms.hModel->IsDynamicModel() != DM_STATIC ) {
+		newTri = R_AllocStaticTriSurf();
+		newTri->ambientSurface = const_cast<srfTriangles_t *>( tri );
+		newTri->numVerts = tri->numVerts;
+		R_ReferenceStaticTriSurfVerts( newTri, tri );
+		R_ReferenceStaticTriSurfIndexes( newTri, tri );
+		newTri->numIndexes = tri->numIndexes;
+		newTri->bounds = tri->bounds;
+		return newTri;
+	}
+
