diff --git a/neo/sys/platform.h b/neo/sys/platform.h
index d156d2fa..ed0b09b1 100644
--- a/neo/sys/platform.h
+++ b/neo/sys/platform.h
@@ -78,6 +78,38 @@ If you have questions concerning this license or the applicable additional terms
 
 #endif
 
+// AmigaOS 3 (68k, GCC with libnix)
+#if defined(__amigaos3__)
+
+// the stack comes from the Shell's Stack command or the icon (no stack swap):
+// sys/amigaos3/amiga_main.cpp checks it at start
+#define _alloca( x )				( ({assert((x)<ID_MAX_ALLOCA_SIZE);}), __builtin_alloca( (x) ) )
+#define _alloca16( x )				( ({assert((x)<ID_MAX_ALLOCA_SIZE);}), ((void *)((((uintptr_t)__builtin_alloca( (x)+15 )) + 15) & ~15)) )
+
+#ifdef GAME_DLL
+#define ID_GAME_API					__attribute__((visibility ("default")))
+#else
+#define ID_GAME_API
+#endif
+
+// as on Unix: no alignment request (the Amiga hunk format cannot align a static
+// object beyond 8 bytes, and the generic SIMD code does not need 16)
+#define ALIGN16( x )				x
+#define PACKED						__attribute__((packed))
+
+#define PATHSEPERATOR_STR			"/"
+#define PATHSEPERATOR_CHAR			'/'
+
+#define __cdecl
+#define ASSERT						assert
+
+#define ID_INLINE					inline
+#define ID_STATIC_TEMPLATE
+
+#define assertmem( x, y )
+
+#endif
+
 // Win32
 #if defined(WIN32) || defined(_WIN32)
 
