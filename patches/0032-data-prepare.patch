--- a/neo/sound/snd_decoder.cpp
+++ b/neo/sound/snd_decoder.cpp
@@ -637,3 +637,85 @@ int idSampleDecoderLocal::DecodeOGG( idSoundSample *sample, int sampleOffset44k,
 
 	return ( readSamples << shift );
 }
+
+/*
+====================
+Patch 0032: the first start's data preparation (framework/DataPrepare.cpp).
+
+Sound_PrepareOgg decodes an OGG file held in memory exactly as
+idSoundSample::Load does at a level load (with s_realTimeDecoding 1, the
+default): the same checks, the same limit test (objectSize < rate * limit,
+objectSize counting every channel), the same decoder and cut to the file's own
+rate (idSoundSample::DecodeOggToShorts).
+Returns the number of 16-bit samples (all channels, native byte order) in
+*pcm (Mem_Alloc'd, the caller frees it), 0 when Load would not decode it at
+load (longer than the limit, or a format Load refuses: it stays OGG), -1 when
+it cannot be read.
+====================
+*/
+static idSoundSample *	prepareSample = NULL;
+static bool				prepareDecoderInit = false;
+
+void Sound_PrepareBegin( void ) {
+	// the sound system initialises the decoder only with a working device
+	if ( soundSystemLocal.soundCache == NULL ) {
+		idSampleDecoder::Init();
+		prepareDecoderInit = true;
+	}
+	if ( prepareSample == NULL ) {
+		prepareSample = new idSoundSample;	// kept: its destructor would call OpenAL
+	}
+}
+
+void Sound_PrepareEnd( void ) {
+	if ( prepareDecoderInit ) {
+		idSampleDecoder::Shutdown();
+		prepareDecoderInit = false;
+	}
+}
+
+int Sound_PrepareOgg( const char *name, const byte *ogg, int oggSize, int limitSeconds, short **pcm, int *channels, int *rate ) {
+	*pcm = NULL;
+
+	int stbverr = 0;
+	stb_vorbis *ov = stb_vorbis_open_memory( ogg, oggSize, &stbverr, NULL );
+	if ( ov == NULL ) {
+		common->Warning( "Preparing '%s': stb_vorbis failed: %s\n", name, my_stbv_strerror( stbverr ) );
+		return -1;
+	}
+	stb_vorbis_info stbvi = stb_vorbis_get_info( ov );
+	int numSamples = stb_vorbis_stream_length_in_samples( ov );
+	stb_vorbis_close( ov );
+
+	// idSoundSample::Load's checks (idWaveFile::OpenOGG gives 16 bits)
+	if ( numSamples <= 0 || ( stbvi.channels != 1 && stbvi.channels != 2 ) ) {
+		return 0;
+	}
+	if ( stbvi.sample_rate != 44100 && stbvi.sample_rate != 22050 && stbvi.sample_rate != 11025 ) {
+		return 0;
+	}
+	int objectSize = numSamples * stbvi.channels;
+	if ( !( objectSize < (int)stbvi.sample_rate * limitSeconds ) ) {
+		return 0;
+	}
+
+	idSoundSample *s = prepareSample;
+	memset( &s->objectInfo, 0, sizeof( s->objectInfo ) );
+	s->name = name;
+	s->objectInfo.wFormatTag = WAVE_FORMAT_TAG_OGG;
+	s->objectInfo.nChannels = stbvi.channels;
+	s->objectInfo.nSamplesPerSec = stbvi.sample_rate;
+	s->objectInfo.wBitsPerSample = 16;
+	s->objectSize = objectSize;
+	s->objectMemSize = oggSize;
+	s->nonCacheData = (byte *)ogg;
+
+	float *dest = (float *)Mem_Alloc( ( s->LengthIn44kHzSamples() + 1 ) * sizeof( float ) );
+	s->DecodeOggToShorts( dest );
+	s->nonCacheData = NULL;
+
+	*pcm = (short *)dest;
+	*channels = stbvi.channels;
+	*rate = stbvi.sample_rate;
+	return objectSize;
+}
