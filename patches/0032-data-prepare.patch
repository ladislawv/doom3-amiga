+// prepared/ folder when that holds a complete preparation of the current
+// originals (and fs_usePrepared is 1), else an empty string
+idStr	DataPrepare_PakFolder( const char *osFolder );
+
+// the first start's preparation: asks (fs_prepare 1) or not (2), then works
+// with a progress screen. True when a folder's preparation was completed now,
+// so that the file system must restart to load it.
+bool	DataPrepare_Run( void );
+
+#endif
