+/*
+================
+CheckPrecompressedImage
+
+Loads the precompressed version of this image (dds/<image name>.dds in the
+game data), from dhewm3 1.5.5 with what GL ES 2.0 cannot use left out: only
+S3TC (DXT1, DXT3, DXT5 and RXGB, which is DXT5 with the normal's x in alpha,
+the layout d3es's interaction shader reads with .agb). Uncompressed,
+palettized and BC7 files fall back to the source image.
+================
+*/
+bool idImage::CheckPrecompressedImage() {
+	// the reasons for not using a .dds go to the developer console (developer 1)
+	if ( !glConfig.isInitialized || !glConfig.textureCompressionAvailable ) {
+		common->DPrintf( "precompressed %s: no GL yet or no S3TC\n", imgName.c_str() );
+		return false;
+	}
+
+	// if we are doing a copyFiles, make sure the original images are referenced
+	if ( fileSystem->PerformingCopyFiles() ) {
+		return false;
+	}
+
+	// id's last minute hack, kept: projected light images look better uncompressed
+	if ( com_machineSpec.GetInteger() >= 1 && imgName.Icmpn( "lights/", 7 ) == 0 ) {
+		common->DPrintf( "precompressed %s: light image, com_machineSpec >= 1\n", imgName.c_str() );
+		return false;
+	}
+
+	char filename[MAX_IMAGE_NAME];
+	ImageProgramStringToCompressedFileName( imgName, filename );
+
+	// opened once: its timestamp from the open file (a file in a pk4 opens
+	// the pk4 again, and reads its header)
+	idFile *f = fileSystem->OpenFileRead( filename );
+	if ( !f ) {
+		common->DPrintf( "precompressed %s: no %s\n", imgName.c_str(), filename );
+		return false;
+	}
+	ID_TIME_T precompTimestamp = f->Timestamp();
+	if ( !generatorFunction && timestamp != FILE_NOT_FOUND_TIMESTAMP && precompTimestamp < timestamp ) {
+		common->DPrintf( "precompressed %s: %s is older than the source (%d < %d)\n", imgName.c_str(), filename,
+			(int)precompTimestamp, (int)timestamp );
+		fileSystem->CloseFile( f );
+		return false;	// the source changed after it was compressed
+	}
+
+	int len = f->Length();
+	if ( len < (int)sizeof( ddsFileHeader_t ) + 4 ) {	// +4: the 'DDS ' magic
+		fileSystem->CloseFile( f );
+		return false;
+	}
+	byte *data = (byte *)R_StaticAlloc( len );
+	f->Read( data, len );
+	fileSystem->CloseFile( f );
+
+	unsigned int magic = LittleInt( *(unsigned int *)data );
+	ddsFileHeader_t *header = (ddsFileHeader_t *)( data + 4 );
+	unsigned int flags = LittleInt( header->ddspf.dwFlags );
+	unsigned int fourCC = LittleInt( header->ddspf.dwFourCC );
+
+	if ( magic != DDS_MAKEFOURCC( 'D', 'D', 'S', ' ' ) ) {
+		common->Printf( "CheckPrecompressedImage( %s ): magic != 'DDS '\n", imgName.c_str() );
+		R_StaticFree( data );
+		return false;
+	}
+
+	bool usable = false;
+	if ( flags & DDSF_FOURCC ) {
+		switch ( fourCC ) {
+		case DDS_MAKEFOURCC( 'D', 'X', 'T', '1' ):
+		case DDS_MAKEFOURCC( 'D', 'X', 'T', '3' ):
+		case DDS_MAKEFOURCC( 'D', 'X', 'T', '5' ):
+			// a normal map must be RXGB: the shader takes x from alpha
+			usable = ( depth != TD_BUMP );
+			break;
+		case DDS_MAKEFOURCC( 'R', 'X', 'G', 'B' ):
+			usable = true;
+			break;
+		}
+	}
+	if ( !usable ) {
+		common->DPrintf( "precompressed %s: format %08x (flags %08x), depth %d not used\n", imgName.c_str(), fourCC, flags, (int)depth );
+		R_StaticFree( data );
+		return false;
+	}
+
+	timestamp = precompTimestamp;
+	UploadPrecompressedImage( data, len );
+	R_StaticFree( data );
+	return precompressedFile;
+}
+
+/*
+===================
+UploadPrecompressedImage
+
+Uploads every mip level of an S3TC .dds file checked by
+CheckPrecompressedImage. The blocks go to GL as they are in the file
+(little-endian, as the GPU reads them); only the header is swapped.
+===================
+*/
+void idImage::UploadPrecompressedImage( byte *data, int len ) {
+	ddsFileHeader_t	*header = (ddsFileHeader_t *)( data + 4 );
+	int flags = LittleInt( header->dwFlags );
+	int width = LittleInt( header->dwWidth );
+	int height = LittleInt( header->dwHeight );
+	int mipCount = LittleInt( header->dwMipMapCount );
+	unsigned int pfFlags = LittleInt( header->ddspf.dwFlags );
+	unsigned int fourCC = LittleInt( header->ddspf.dwFourCC );
+
+	switch ( fourCC ) {
+	case DDS_MAKEFOURCC( 'D', 'X', 'T', '1' ):
+		internalFormat = ( pfFlags & DDSF_ALPHAPIXELS ) ? GL_COMPRESSED_RGBA_S3TC_DXT1_EXT : GL_COMPRESSED_RGB_S3TC_DXT1_EXT;
+		break;
+	case DDS_MAKEFOURCC( 'D', 'X', 'T', '3' ):
+		internalFormat = GL_COMPRESSED_RGBA_S3TC_DXT3_EXT;
+		break;
+	default:	// DXT5, RXGB
+		internalFormat = GL_COMPRESSED_RGBA_S3TC_DXT5_EXT;
+		break;
+	}
+	int blockBytes = ( internalFormat == GL_COMPRESSED_RGB_S3TC_DXT1_EXT
+		|| internalFormat == GL_COMPRESSED_RGBA_S3TC_DXT1_EXT ) ? 8 : 16;
+
+	PurgeImage();
+	qglGenTextures( 1, &texnum );
+	precompressedFile = false;
+	type = TT_2D;	// no precompressed cube maps
+
+	uploadWidth = width;
+	uploadHeight = height;
+	GetDownsize( uploadWidth, uploadHeight );	// levels above it are skipped
+
+	Bind();
+
+	int numMipmaps = ( flags & DDSF_MIPMAPCOUNT ) ? mipCount : 1;
+	if ( numMipmaps < 1 ) {
+		numMipmaps = 1;
+	}
+	const byte *imagedata = data + 4 + sizeof( ddsFileHeader_t );
+	const byte *end = data + len;
+	int uw = width, uh = height;
+	int lastUW = uw, lastUH = uh;
+	int skipMip = 0, uploaded = 0;
+
+	for ( int i = 0; i < numMipmaps; i++ ) {
+		int size = ( ( uw + 3 ) / 4 ) * ( ( uh + 3 ) / 4 ) * blockBytes;
+		if ( imagedata + size > end ) {
+			common->Warning( "UploadPrecompressedImage( %s ): file ends in mip level %d", imgName.c_str(), i );
+			break;
+		}
+		if ( uw > uploadWidth || uh > uploadHeight ) {
+			skipMip++;
+		} else {
+			qglCompressedTexImage2D( GL_TEXTURE_2D, i - skipMip, internalFormat, uw, uh, 0, size, imagedata );
+			uploaded++;
+		}
+		lastUW = uw;
+		lastUH = uh;
+		imagedata += size;
+		uw = uw > 1 ? uw / 2 : 1;
+		uh = uh > 1 ? uh / 2 : 1;
+	}
+	if ( !uploaded ) {
+		PurgeImage();
+		return;		// precompressedFile stays false: the caller loads the source image
+	}
+
+	// GL ES 2.0 has no GL_TEXTURE_MAX_LEVEL: a mip chain that stops above 1x1
+	// leaves the texture incomplete under a mipmapping filter, so use level 0 only
+	if ( ( lastUW > 1 || lastUH > 1 ) && filter == TF_DEFAULT ) {
+		filter = TF_LINEAR;
+	}
+
+	precompressedFile = true;
+	SetImageFilterAndRepeat();
+	GL_CheckErrors();
+}
