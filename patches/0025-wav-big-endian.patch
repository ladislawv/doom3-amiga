diff --git a/neo/sound/snd_cache.cpp b/neo/sound/snd_cache.cpp
index 7ae5943c..21f5b648 100644
--- a/neo/sound/snd_cache.cpp
+++ b/neo/sound/snd_cache.cpp
@@ -482,6 +482,17 @@ void idSoundSample::Load( void ) {
 	nonCacheData = (byte *)soundCacheAllocator.Alloc( objectMemSize );
 	fh.Read( nonCacheData, objectMemSize, NULL );
 
+	// port (patch 0025): a WAV file's 16-bit PCM is little-endian; everything
+	// after this (the downsampling, OpenAL, the streaming path) takes native
+	// samples, so a big-endian machine (the 68k) played it as noise. OGG data
+	// stays compressed here; its decoder writes native samples.
+	if ( objectInfo.wFormatTag == WAVE_FORMAT_TAG_PCM ) {
+		short *pcm = (short *)nonCacheData;
+		for ( int i = 0; i < objectMemSize / (int)sizeof( short ); i++ ) {
+			pcm[i] = LittleShort( pcm[i] );
+		}
+	}
+
 	// optionally convert it to 22kHz to save memory
 	CheckForDownSample();
 
