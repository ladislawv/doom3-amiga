 void Com_ExecMachineSpec_f( const idCmdArgs &args ) {
+#ifdef __amigaos3__
+	// patch 0033: a quality preset keeps the screen mode (the player's own choice)
+	int keepMode = cvarSystem->GetCVarInteger( "r_mode" );
+#endif
 	if ( com_machineSpec.GetInteger() == 3 ) {
 		cvarSystem->SetCVarInteger( "image_anisotropy", 1, CVAR_ARCHIVE );
 		cvarSystem->SetCVarInteger( "image_lodbias", 0, CVAR_ARCHIVE );
@@ -1561,7 +1565,46 @@ void Com_ExecMachineSpec_f( const idCmdArgs &args ) {
 		cvarSystem->SetCVarBool( "r_shadows", true, CVAR_ARCHIVE );
 	}
 #endif
+
+#ifdef __amigaos3__
+	// patch 0033: the screen mode as it was; precompressed (DDS) textures in every
+	// preset (Ultra's TGAs cost the 68k minutes a level); then the port's settings
+	// for the preset (low.cfg, medium.cfg, high.cfg, ultra.cfg: shadows, effects,
+	// sound), which the launcher copies to the save directory
+	cvarSystem->SetCVarInteger( "r_mode", keepMode, CVAR_ARCHIVE );
+	cvarSystem->SetCVarInteger( "image_usePrecompressedTextures", 1, CVAR_ARCHIVE );
+	static const char *specCfg[4] = { "low.cfg", "medium.cfg", "high.cfg", "ultra.cfg" };
+	int spec = idMath::ClampInt( 0, 3, com_machineSpec.GetInteger() );
+	if ( fileSystem->ReadFile( specCfg[spec], NULL, NULL ) > 0 ) {
+		cmdSystem->BufferCommandText( CMD_EXEC_NOW, va( "exec %s\n", specCfg[spec] ) );
+	}
+#endif
+}
+
+#ifdef __amigaos3__
+/*
+=================
+Com_AmigaFirstStart
+
+Patch 0033: the port's settings at the first start (no config.spec yet), in
+place of the detection from the memory (which picks "Ultra" from the 1.9 GB):
+Low quality, 1280x720 full screen, the frame rate shown. All are saved in the
+configuration, so what the player changes later (menu or console) stays.
+=================
+*/
+static void Com_AmigaFirstStart( void ) {
+	common->Printf( "First start: the AmigaOS port's settings (Low, 1280x720, frame rate shown)\n" );
+	cvarSystem->SetCVarInteger( "r_mode", 9, CVAR_ARCHIVE );			// 1280x720
+	cvarSystem->SetCVarBool( "r_fullscreen", true, CVAR_ARCHIVE );
+	cvarSystem->SetCVarInteger( "com_showFPS", 1, CVAR_ARCHIVE );
+	cvarSystem->SetCVarInteger( "r_swapInterval", 0, CVAR_ARCHIVE );
+	cvarSystem->SetCVarInteger( "r_maxLights", 12, CVAR_ARCHIVE );
+	cvarSystem->SetCVarInteger( "com_gameHz", 20, CVAR_ARCHIVE );
+	com_machineSpec.SetInteger( 0 );
+	idCmdArgs args;
+	Com_ExecMachineSpec_f( args );
 }
+#endif
 
