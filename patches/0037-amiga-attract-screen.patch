+/*
+================
+AmigaAttractScreen
+
+The Amiga port's attract screen: the arcade cabinet in Mars City shows
+guis/amiga/attract.gui (from the port's amiga.pk4) in place of its own GUI
+until the player clicks it; the GUI's "amigaAttractEnd" command then puts the
+cabinet's own GUI back (idEntity::HandleGuiCommands). Nothing changes when the
+port's GUI is missing or g_amigaAttract is 0.
+================
+*/
+static idCVar g_amigaAttract( "g_amigaAttract", "1", CVAR_GAME | CVAR_BOOL, "the Mars City arcade cabinet shows the Amiga attract screen until it is clicked" );
+
+static void AmigaAttractScreen( const char *mapFileName, idDict &args ) {
+	static const struct {
+		const char *map;
+		const char *entity;
+		const char *gui;
+	} screens[] = {
+		{ "mars_city1",			"func_static_4311", "guis/marscity/sttp.gui" },
+		{ "demo_mars_city1",	"func_static_4311", "guis/marscity/sttp.gui" },
+	};
+	const char *attractGui = "guis/amiga/attract.gui";
+
+	if ( !g_amigaAttract.GetBool() ) {
+		return;
+	}
+	idStr map = mapFileName;
+	map.StripPath();
+	map.StripFileExtension();
+	for ( int i = 0; i < (int)( sizeof( screens ) / sizeof( screens[0] ) ); i++ ) {
+		if ( map.Icmp( screens[i].map ) != 0 ||
+			 idStr::Icmp( args.GetString( "name" ), screens[i].entity ) != 0 ||
+			 idStr::Icmp( args.GetString( "gui" ), screens[i].gui ) != 0 ) {
+			continue;
+		}
+		if ( fileSystem->ReadFile( attractGui, NULL, NULL ) <= 0 ) {
+			return;
+		}
+		args.Set( "amiga_attract_next", screens[i].gui );
+		args.Set( "gui", attractGui );
+		return;
+	}
+}
+
