diff --git a/neo/renderer/draw_common.cpp b/neo/renderer/draw_common.cpp
index 92996118..db44ceaf 100644
--- a/neo/renderer/draw_common.cpp
+++ b/neo/renderer/draw_common.cpp
@@ -73,6 +73,18 @@ void RB_BakeTextureMatrixIntoTexgen( idMat4 & lightProject, const float *texture
 	lightProject[1][3] = final[13];
 }
 
+/*
+=============
+rb_stageMsec
+
+Time spent in the back end's stages since the benchmark last cleared them
+(com_benchmarkSeconds reports them per frame): 0 view set-up, 1 depth fill,
+2 interactions (with the stencil shadows), 3 shader passes, 4 fog and blend
+lights, 5 post-processing passes, 6 buffer swap (tr_backend.cpp).
+=============
+*/
+double rb_stageMsec[RB_NUM_STAGES];
+
 /*
 =============
 RB_RenderView
@@ -81,15 +93,18 @@ RB_RenderView
 void RB_RenderView(void) {
 	drawSurf_t **drawSurfs = (drawSurf_t * *) & backEnd.viewDef->drawSurfs[0];
 	const int numDrawSurfs = backEnd.viewDef->numDrawSurfs;
+	double t0 = Sys_MillisecondsPrecise(), t1;
 
 	// clear the z buffer, set the projection matrix, etc
 	RB_BeginDrawingView();
 
 	// Setup GLSL shader state
 	RB_GLSL_PrepareShaders();
+	t1 = Sys_MillisecondsPrecise(); rb_stageMsec[0] += t1 - t0; t0 = t1;
 
 	// fill the depth buffer and clear color buffer to black except on subviews
 	RB_GLSL_FillDepthBuffer( drawSurfs, numDrawSurfs );
+	t1 = Sys_MillisecondsPrecise(); rb_stageMsec[1] += t1 - t0; t0 = t1;
 
 #ifdef NO_LIGHT
 	if ( !r_noLight.GetBool() )
@@ -99,15 +114,19 @@ void RB_RenderView(void) {
 
 	// disable stencil shadow test
 	qglStencilFunc(GL_ALWAYS, 128, 255);
+	t1 = Sys_MillisecondsPrecise(); rb_stageMsec[2] += t1 - t0; t0 = t1;
 
 	// now draw any non-light dependent shading passes
 	const int processed = RB_GLSL_DrawShaderPasses(drawSurfs, numDrawSurfs);
+	t1 = Sys_MillisecondsPrecise(); rb_stageMsec[3] += t1 - t0; t0 = t1;
 
 	// fog and blend lights
 	RB_GLSL_FogAllLights();
+	t1 = Sys_MillisecondsPrecise(); rb_stageMsec[4] += t1 - t0; t0 = t1;
 
 	// now draw any post-processing effects using _currentRender
 	if (processed < numDrawSurfs) {
 		RB_GLSL_DrawShaderPasses(drawSurfs + processed, numDrawSurfs - processed);
 	}
+	t1 = Sys_MillisecondsPrecise(); rb_stageMsec[5] += t1 - t0;
 }
diff --git a/neo/renderer/tr_backend.cpp b/neo/renderer/tr_backend.cpp
index 4022920a..68b676a5 100644
--- a/neo/renderer/tr_backend.cpp
+++ b/neo/renderer/tr_backend.cpp
@@ -341,11 +341,15 @@ const void	RB_SwapBuffers( const void *data ) {
 		qglFinish();
 	}
 
+	double t0 = Sys_MillisecondsPrecise();
+
 	R_FrameBufferEnd();
 
 	GLimp_SwapBuffers();
 
 	R_FrameBufferStart();
+
+	rb_stageMsec[6] += Sys_MillisecondsPrecise() - t0;	// the benchmark's "swap"
 }
 
