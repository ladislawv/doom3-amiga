diff --git a/neo/framework/Common.h b/neo/framework/Common.h
index 13aec6b2..0ccd2f8d 100644
--- a/neo/framework/Common.h
+++ b/neo/framework/Common.h
@@ -296,4 +296,24 @@ public:
 
 extern idCommon *		common;
 
+// port (patch 0018): time spent loading, summed by kind from the start of a
+// map change and printed after its "msec to load" (idSessionLocal::ExecuteMapChange);
+// models count their materials' images too; inside the images: their DDS
+// files read and checked, image files read and decoded, uploads (with mipmaps);
+// and every file opened in a pk4 (unzReOpen opens the pk4 again)
+enum { LOAD_IMAGES, LOAD_MODELS, LOAD_SOUNDS, LOAD_IMAGE_DDS, LOAD_IMAGE_FILES, LOAD_IMAGE_UPLOADS,
+	LOAD_ZIP_OPENS, LOAD_NUM_KINDS };
+// the sums so far as one line
+void					Com_PrintLoadTimes( const char *when );
+extern double			com_loadMsec[LOAD_NUM_KINDS];
+extern int				com_loadCount[LOAD_NUM_KINDS];
+class idLoadTimer {		// the time of its scope added to one kind
+public:
+						idLoadTimer( int kind );
+						~idLoadTimer();
+private:
+	int					kind;
+	double				start;
+};
+
 #endif /* !__COMMON_H__ */
