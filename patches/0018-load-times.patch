+/*
+===============
+Load times (Common.h, patch 0018)
+===============
+*/
+double com_loadMsec[LOAD_NUM_KINDS];
+int com_loadCount[LOAD_NUM_KINDS];
+
+idLoadTimer::idLoadTimer( int kind ) : kind( kind ), start( Sys_MillisecondsPrecise() ) {
+}
+
+idLoadTimer::~idLoadTimer() {
+	com_loadMsec[kind] += Sys_MillisecondsPrecise() - start;
+	com_loadCount[kind]++;
+}
+
+void Com_PrintLoadTimes( const char *when ) {
+	common->Printf( "load %s: %d images in %.0f msec (DDS %d in %.0f, files %d in %.0f, uploads %d in %.0f), "
+		"%d models in %.0f msec (with their images), %d sounds in %.0f msec, %d pk4 file opens in %.0f msec\n", when,
+		com_loadCount[LOAD_IMAGES], com_loadMsec[LOAD_IMAGES], com_loadCount[LOAD_IMAGE_DDS], com_loadMsec[LOAD_IMAGE_DDS],
+		com_loadCount[LOAD_IMAGE_FILES], com_loadMsec[LOAD_IMAGE_FILES], com_loadCount[LOAD_IMAGE_UPLOADS],
+		com_loadMsec[LOAD_IMAGE_UPLOADS], com_loadCount[LOAD_MODELS], com_loadMsec[LOAD_MODELS],
+		com_loadCount[LOAD_SOUNDS], com_loadMsec[LOAD_SOUNDS], com_loadCount[LOAD_ZIP_OPENS], com_loadMsec[LOAD_ZIP_OPENS] );
+}
