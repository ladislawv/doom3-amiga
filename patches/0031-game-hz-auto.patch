+// The AmigaOS 3 port (patch 0031): the game's tick rate follows the frame rate
+// it reaches, 5 Hz above it, between com_gameHzMin and com_gameHzMax. Doom 3
+// renders one frame a game tic, so a fixed rate caps the frame rate at it
+// (20 Hz: 20 fps where the A1200 could show more), and a rate the machine
+// cannot keep runs several tics a frame. The effective rate is set directly
+// (Com_SetGameHz), not com_gameHz, which stays the player's start value and is
+// not written to the configuration at every change.
+#ifdef __amigaos3__
+#define COM_GAMEHZAUTO_DEFAULT "1"
+#else
+#define COM_GAMEHZAUTO_DEFAULT "0"
+#endif
+idCVar com_gameHzAuto( "com_gameHzAuto", COM_GAMEHZAUTO_DEFAULT, CVAR_BOOL | CVAR_ARCHIVE | CVAR_SYSTEM, "adapt the game's tick rate to the frame rate reached, between com_gameHzMin and com_gameHzMax" );
+idCVar com_gameHzMin( "com_gameHzMin", "20", CVAR_INTEGER | CVAR_ARCHIVE | CVAR_SYSTEM, "com_gameHzAuto's lowest tick rate", 10, 250 );
+idCVar com_gameHzMax( "com_gameHzMax", "60", CVAR_INTEGER | CVAR_ARCHIVE | CVAR_SYSTEM, "com_gameHzAuto's highest tick rate", 10, 250 );
