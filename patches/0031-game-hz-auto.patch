+/*
+==================
+Com_AutoGameHz
+
+com_gameHzAuto, once a frame: over each half second, the frames rendered; the
+tick rate then 5 Hz above them (the developer's rule), within com_gameHzMin
+and com_gameHzMax. Frames capped by the rate push it up 5 Hz a half second;
+frames the machine cannot render at a higher rate hold it 5 Hz above them.
+Changed only by 2 Hz or more (the console logs each change). A half second
+with one frame of more than 500 ms (a load, a hitch) is not counted.
+==================
+*/
+void Com_AutoGameHz( void )
+{
+	static int windowStart = 0, windowFrames = 0, lastFrame = 0, longFrame = 0;
+	int now, lo, hi, hz;
+	float fps;
+
+	if ( !com_gameHzAuto.GetBool() ) {
+		windowStart = 0;
+		return;
+	}
+	now = Sys_Milliseconds();
+	if ( !windowStart ) {
+		windowStart = lastFrame = now;
+		windowFrames = 0;
+		longFrame = 0;
+		return;
+	}
+	if ( now - lastFrame > 500 ) {
+		longFrame = 1;
+	}
+	lastFrame = now;
+	windowFrames++;
+	if ( now - windowStart < 500 ) {
+		return;
+	}
+	fps = windowFrames * 1000.0f / ( now - windowStart );
+	windowStart = now;
+	windowFrames = 0;
+	if ( longFrame ) {
+		longFrame = 0;
+		return;
+	}
+
+	lo = com_gameHzMin.GetInteger();
+	hi = idMath::ClampInt( lo, 250, com_gameHzMax.GetInteger() );
+	hz = idMath::ClampInt( lo, hi, (int)( fps + 0.5f ) + 5 );
+	if ( ( hz > com_gameHzVal ? hz - com_gameHzVal : com_gameHzVal - hz ) >= 2 ||
+		 ( hz != com_gameHzVal && ( hz == lo || hz == hi ) ) ) {
+		Com_SetGameHz( hz );
+	}
+}
