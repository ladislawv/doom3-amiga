diff --git a/neo/game/Actor.cpp b/neo/game/Actor.cpp
index 4651c91d..c1bc7275 100644
--- a/neo/game/Actor.cpp
+++ b/neo/game/Actor.cpp
@@ -33,6 +33,7 @@ If you have questions concerning this license or the applicable additional terms
 #include "Light.h"
 #include "Projectile.h"
 #include "WorldSpawn.h"
+#include "Player.h"
 
 #include "Actor.h"
 
@@ -417,6 +418,7 @@ idActor::idActor
 */
 idActor::idActor( void ) {
 	viewAxis.Identity();
+	walkIKOff = false;
 
 	scriptThread		= NULL;		// initialized by ConstructScriptObject, which is called by idEntity::Spawn
 
@@ -1688,6 +1690,29 @@ bool idActor::UpdateAnimationControllers( void ) {
 	}
 
 	if ( walkIK.IsInitialized() ) {
+		// port (patch 0022, from doom3bfg-vita): the walk IK fits the feet to
+		// the floor, rebuilding the skeleton and tracing 2-3 boxes every tic.
+		// Skipped for the player while his body cannot be seen (in single
+		// player his body is hidden from his view and casts no shadow), and
+		// for actors beyond g_ikDistance; their legs keep the animated pose
+		// (the joint mods are cleared once).
+		const idPlayer *player = gameLocal.GetLocalPlayer();
+		bool skip = false;
+		if ( player == this ) {
+			skip = !g_playerWalkIK.GetBool() && !gameLocal.isMultiplayer && !g_showPlayerShadow.GetBool() &&
+				!pm_thirdPerson.GetBool() && !gameLocal.inCinematic;
+		} else if ( g_ikDistance.GetFloat() > 0.0f && player != NULL ) {
+			skip = ( GetPhysics()->GetOrigin() - player->GetPhysics()->GetOrigin() ).LengthSqr() >
+				Square( g_ikDistance.GetFloat() );
+		}
+		if ( skip ) {
+			if ( !walkIKOff ) {
+				walkIK.ClearJointMods();
+				walkIKOff = true;
+			}
+			return false;
+		}
+		walkIKOff = false;
 		walkIK.Evaluate();
 		return true;
 	}
