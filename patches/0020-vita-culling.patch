+/*
+==============
+PushBoxIntoTree
+
+Port (patch 0020, after ldhewm3-rearmed's Vita port): an entity's local
+bounds pushed down the area tree as the box they are in world space, in
+place of its eight corners transformed and each tested against every node's
+plane. At a node, the box is in front when its nearest corner is (distance
+from its center minus its half extent along the plane's normal), as the
+corners' test decides it. The half axes come from the model matrix, so a
+scaled entity's box is exact too.
+==============
+*/
+void idRenderWorldLocal::PushBoxIntoTree_r( idRenderEntityLocal *def, const idVec3 &center, const idVec3 halfAxes[3], float radius, int nodeNum ) {
+	if ( nodeNum < 0 ) {
+		portalArea_t *area = &portalAreas[ -1 - nodeNum ];
+		if ( area->viewCount == tr.viewCount ) {
+			return;	// already added a reference here
+		}
+		area->viewCount = tr.viewCount;
+		AddEntityRefToArea( def, area );
+		return;
+	}
+
+	const areaNode_t *node = areaNodes + nodeNum;
+
+	// as PushVolumeIntoTree_r: all the children's areas already referenced
+	if ( r_useNodeCommonChildren.GetBool() && node->commonChildrenArea != CHILDREN_HAVE_MULTIPLE_AREAS ) {
+		if ( portalAreas[ node->commonChildrenArea ].viewCount == tr.viewCount ) {
+			return;
+		}
+	}
+
+	const float d = node->plane.Distance( center );
+	bool front, back;
+	if ( d >= radius ) {
+		front = true;
+		back = false;
+	} else if ( d <= -radius ) {
+		front = false;
+		back = true;
+	} else {
+		const idVec3 &n = node->plane.Normal();
+		const float extent = idMath::Fabs( n * halfAxes[0] ) + idMath::Fabs( n * halfAxes[1] ) + idMath::Fabs( n * halfAxes[2] );
+		front = d + extent >= 0.0f;	// the farthest corner at or in front of the plane
+		back = d - extent < 0.0f;	// the nearest one behind it
+	}
+	if ( front && node->children[0] ) {	// 0 = solid
+		PushBoxIntoTree_r( def, center, halfAxes, radius, node->children[0] );
+	}
+	if ( back && node->children[1] ) {
+		PushBoxIntoTree_r( def, center, halfAxes, radius, node->children[1] );
+	}
+}
+
+void idRenderWorldLocal::PushBoxIntoTree( idRenderEntityLocal *def, const idBounds &bounds, const float modelMatrix[16] ) {
+	if ( areaNodes == NULL ) {
+		return;
+	}
+	idVec3 center, halfAxes[3];
+	const idVec3 localCenter = ( bounds[0] + bounds[1] ) * 0.5f;
+	const idVec3 extents = bounds[1] - localCenter;
+	R_LocalPointToGlobal( modelMatrix, localCenter, center );
+	for ( int i = 0; i < 3; i++ ) {
+		halfAxes[i].Set( modelMatrix[i * 4 + 0], modelMatrix[i * 4 + 1], modelMatrix[i * 4 + 2] );
+		halfAxes[i] *= extents[i];
+	}
+	// the corners' bounding sphere: half the box's diagonal
+	const float radius = ( halfAxes[0] + halfAxes[1] + halfAxes[2] ).Length();
+	PushBoxIntoTree_r( def, center, halfAxes, radius, 0 );
+}
