+				GameProfile_AddThink( ent->GetType()->typeNum, ent->entityNumber, t1 - t0 );
+				t0 = t1;
+				num++;
+			}
+			gp_msec[GP_THINK] += t0 - thinkStart;
+		} else if ( g_timeentities.GetFloat() ) {
 			num = 0;
 			for( ent = activeEntities.Next(); ent != NULL; ent = ent->activeNode.Next() ) {
 				if ( g_cinematic.GetBool() && inCinematic && !ent->cinematic ) {
@@ -2382,7 +2523,10 @@ gameReturn_t idGameLocal::RunFrame( const usercmd_t *clientCmds ) {
 		timer_events.Start();
 
