+
+#ifndef __GAME_PROFILE_H__
+#define __GAME_PROFILE_H__
+
+/*
+===============================================================================
+
+	Game profile (g_profileThink 1): the time of each part of the game's
+	frames, and the think time of each entity class, summed until
+	"gameProfile print" ("gameProfile reset" starts again; the benchmark
+	does both, around its counted seconds). The parts below the think loop
+	(physics, animation, render world updates, scripts) are also inside
+	their entities' think time; each is counted once when nested.
+
+===============================================================================
+*/
+
+#include "sys/sys_public.h"
+
+class idCmdArgs;
+
+enum {
+	GP_FRAME,			// all of RunFrame
+	GP_FRAME_START,		// RunFrame up to the entities' think
+	GP_THINK,			// every entity's Think
+	GP_EVENTS,			// idEvent::ServiceEvents
+	GP_PHYSICS,			// idEntity::RunPhysics
+	GP_ANIMATION,		// idAnimatedEntity::UpdateAnimation
+	GP_PRESENT,			// idEntity::Present: the render world's entity updates
+	GP_SCRIPT,			// idThread::Execute: the script interpreter
+	GP_PUSH,			// idPush::ClipPush: a pusher's move tried against what it touches
+	GP_CLIP_LINK,		// idClipModel::Link: a clip model put into the clip sectors
+	GP_CLIP_QUERY,		// idClip's traces, contacts and contents tests
+	GP_NUM
+};
+
+extern bool		gp_on;				// g_profileThink, read at each RunFrame
+extern double	gp_msec[GP_NUM];
+extern int		gp_depth[GP_NUM];
+extern int		gp_count[GP_NUM];	// entries, nested ones too
+
+void			GameProfile_StartTic( void );
+void			GameProfile_AddThink( int typeNum, int entityNum, double msec );
+void			GameProfile_f( const idCmdArgs &args );	// "gameProfile reset|print"
+
+class idGameProfileScope {
+public:
+	idGameProfileScope( int part ) : part( part ), entered( false ), timing( false ), t0( 0.0 ) {
+		if ( gp_on ) {
+			entered = true;
+			gp_count[part]++;
+			if ( gp_depth[part]++ == 0 ) {
+				timing = true;
+				t0 = Sys_MillisecondsPrecise();
+			}
+		}
+	}
+	~idGameProfileScope() {
+		if ( entered ) {
+			gp_depth[part]--;
+			if ( timing ) {
+				gp_msec[part] += Sys_MillisecondsPrecise() - t0;
+			}
+		}
+	}
+private:
+	int		part;
+	bool	entered, timing;
+	double	t0;
+};
+
+#endif /* !__GAME_PROFILE_H__ */
