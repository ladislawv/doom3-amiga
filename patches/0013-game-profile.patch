 }
 
+/*
+================
+Game profile (GameProfile.h)
+================
+*/
+bool			gp_on;
+double			gp_msec[GP_NUM];
+int				gp_depth[GP_NUM];
+int				gp_count[GP_NUM];
+static int		gp_tics;
+static idList<double> gp_classMsec;		// by idTypeInfo::typeNum
+static idList<int> gp_classThinks;
+static double	gp_entityMsec[MAX_GENTITIES];	// by entity number
+
+void GameProfile_StartTic( void ) {
+	gp_tics++;
+}
+
+void GameProfile_AddThink( int typeNum, int entityNum, double msec ) {
+	if ( typeNum >= gp_classMsec.Num() ) {
+		gp_classMsec.AssureSize( typeNum + 1, 0.0 );
+		gp_classThinks.AssureSize( typeNum + 1, 0 );
+	}
+	gp_classMsec[typeNum] += msec;
+	gp_classThinks[typeNum]++;
+	if ( entityNum >= 0 && entityNum < MAX_GENTITIES ) {
+		gp_entityMsec[entityNum] += msec;
+	}
+}
+
+// the n most expensive of count values, the most expensive first
+static void GameProfile_Top( const double *msec, int count, int n, idList<int> &order ) {
+	int i, j, k;
+	order.Clear();
+	for ( i = 0; i < count; i++ ) {
+		if ( msec[i] > 0.0 ) {
+			order.Append( i );
+		}
+	}
+	for ( i = 0; i < order.Num() && i < n; i++ ) {
+		for ( j = i + 1; j < order.Num(); j++ ) {
+			if ( msec[order[j]] > msec[order[i]] ) {
+				k = order[i];
+				order[i] = order[j];
+				order[j] = k;
+			}
+		}
+	}
+	if ( order.Num() > n ) {
+		order.SetNum( n );
+	}
+}
+
+void GameProfile_f( const idCmdArgs &args ) {
+	int i, n;
+	if ( !idStr::Icmp( args.Argv( 1 ), "reset" ) ) {
+		memset( gp_msec, 0, sizeof( gp_msec ) );
+		memset( gp_count, 0, sizeof( gp_count ) );
+		memset( gp_entityMsec, 0, sizeof( gp_entityMsec ) );
+		gp_tics = 0;
+		gp_classMsec.Clear();
+		gp_classThinks.Clear();
+		return;
+	}
+	if ( idStr::Icmp( args.Argv( 1 ), "print" ) ) {
+		gameLocal.Printf( "usage: gameProfile reset|print (what g_profileThink 1 counted)\n" );
+		return;
+	}
+	if ( !gp_tics ) {
+		gameLocal.Printf( "gameProfile: no game tics counted (g_profileThink 1 counts them)\n" );
+		return;
+	}
+	// what one timer call costs: the think loop makes one per entity, each
+	// part two (they are in the numbers below)
+	double t0 = Sys_MillisecondsPrecise();
+	for ( i = 0; i < 1000; i++ ) {
+		Sys_MillisecondsPrecise();
+	}
+	double callUsec = Sys_MillisecondsPrecise() - t0;	// ms for 1000 calls: us for one
+
+	const double f = 1.0 / gp_tics;
+	gameLocal.Printf( "gameProfile: %d tics; per tic %.2f ms in RunFrame: %.2f before the think, %.2f think, "
+		"%.2f events, %.2f the rest\n", gp_tics, gp_msec[GP_FRAME] * f, gp_msec[GP_FRAME_START] * f,
+		gp_msec[GP_THINK] * f, gp_msec[GP_EVENTS] * f,
+		( gp_msec[GP_FRAME] - gp_msec[GP_FRAME_START] - gp_msec[GP_THINK] - gp_msec[GP_EVENTS] ) * f );
+	gameLocal.Printf( "gameProfile: per tic, within the think and events: %.2f ms physics, %.2f animation, "
+		"%.2f render world updates, %.2f scripts\n", gp_msec[GP_PHYSICS] * f, gp_msec[GP_ANIMATION] * f,
+		gp_msec[GP_PRESENT] * f, gp_msec[GP_SCRIPT] * f );
+	gameLocal.Printf( "gameProfile: per tic, collision (mostly in the physics): %.2f ms pushes (%.1f calls), "
+		"%.2f clip links (%.1f), %.2f clip queries (%.1f)\n", gp_msec[GP_PUSH] * f, gp_count[GP_PUSH] * f, gp_msec[GP_CLIP_LINK] * f,
+		gp_count[GP_CLIP_LINK] * f, gp_msec[GP_CLIP_QUERY] * f, gp_count[GP_CLIP_QUERY] * f );
+	gameLocal.Printf( "gameProfile: a timer call costs %.2f us\n", callUsec );
+
+	// the classes, the most expensive first
+	idList<int> order;
+	GameProfile_Top( gp_classMsec.Ptr(), gp_classMsec.Num(), 30, order );
+	for ( i = 0; i < order.Num(); i++ ) {
+		n = order[i];
+		gameLocal.Printf( "gameProfile: %6.2f ms per tic, %5.1f thinks per tic, %6.3f ms each: %s\n",
+			gp_classMsec[n] * f, gp_classThinks[n] * f, gp_classMsec[n] / gp_classThinks[n],
+			idClass::GetType( n )->classname );
+	}
+
+	// the entities, the most expensive first (still in the game: their name)
+	GameProfile_Top( gp_entityMsec, MAX_GENTITIES, 30, order );
+	for ( i = 0; i < order.Num(); i++ ) {
+		n = order[i];
+		const idEntity *ent = gameLocal.entities[n];
+		gameLocal.Printf( "gameProfile: entity %4d %6.3f ms per tic: %s (%s)\n", n, gp_entityMsec[n] * f,
+			ent ? ent->GetName() : "(removed)", ent ? ent->GetClassname() : "" );
+	}
+}
+
