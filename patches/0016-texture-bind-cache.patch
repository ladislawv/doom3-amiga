@@ -99,6 +100,30 @@ void GL_SelectTexture( int unit ) {
 	}
 }
 
+/*
+====================
+GL_BindImage, GL_ForgetTextureBindings
+
+Port (patch 0016): every glActiveTexture and glBindTexture is a library call
+on the Amiga; an interaction draw made ten of them for its five textures,
+the light's two the same for all of its surfaces.
+====================
+*/
+void GL_BindImage( int unit, idImage *image ) {
+	if ( image->IsBoundOn( unit ) ) {
+		return;
+	}
+	GL_SelectTexture( unit );
+	image->Bind();
+}
+
+void GL_ForgetTextureBindings( void ) {
+	for ( int i = 0; i < MAX_MULTITEXTURE_UNITS; i++ ) {
+		backEnd.glState.tmu2D[i] = (GLuint)idImage::TEXTURE_NOT_LOADED;
+		backEnd.glState.tmuCube[i] = (GLuint)idImage::TEXTURE_NOT_LOADED;
+	}
+}
+
 
