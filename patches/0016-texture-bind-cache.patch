+	GLuint *bound = TextureUnitBinding( backEnd.glState.currentTexture, type );
+	if ( bound && *bound == texnum && r_useBindCache.GetBool() ) {
+		return true;
+	}
 	if ( type == TT_2D ) {
 		qglBindTexture( GL_TEXTURE_2D, texnum );
 	} else if ( type == TT_CUBIC ) {
 		qglBindTexture( GL_TEXTURE_CUBE_MAP, texnum );
 	}
+	if ( bound ) {
+		*bound = texnum;
+	}
 	return true;
 }
 
@@ -1193,12 +1242,19 @@ void idImage::BindFragment() {
