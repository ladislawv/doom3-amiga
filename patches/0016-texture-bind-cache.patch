-	// bind the texture
+	// bind the texture, unless the current unit has it already
+	GLuint *bound = TextureUnitBinding( backEnd.glState.currentTexture, type );
+	if ( bound && *bound == texnum && texnum != TEXTURE_NOT_LOADED && r_useBindCache.GetBool() ) {
+		return;
+	}
 	if ( type == TT_2D ) {
 		qglBindTexture( GL_TEXTURE_2D, texnum );
 	} else if ( type == TT_CUBIC ) {
