 		texnum = TEXTURE_NOT_LOADED;
+		// GL unbound it wherever it was bound, and may give its number to a new one
+		GL_ForgetTextureBindings();
 	}
 }
 
+/*
+==============
+TextureUnitBinding
+
+The texture unit cache's entry for this image's target on the current unit
+(backEnd.glState.tmu2D/tmuCube, patch 0016), NULL if unknown or none
+==============
+*/
+static GLuint *TextureUnitBinding( int unit, textureType_t type ) {
+	if ( unit < 0 || unit >= MAX_MULTITEXTURE_UNITS ) {
+		return NULL;
+	}
+	if ( type == TT_2D ) {
+		return &backEnd.glState.tmu2D[unit];
+	}
+	if ( type == TT_CUBIC ) {
+		return &backEnd.glState.tmuCube[unit];
+	}
+	return NULL;
+}
+
+/*
+==============
+IsBoundOn
+==============
+*/
+bool idImage::IsBoundOn( int unit ) {
+	if ( texnum == TEXTURE_NOT_LOADED || !r_useBindCache.GetBool() ) {
+		return false;
+	}
+	const GLuint *bound = TextureUnitBinding( unit, type );
+	if ( !bound || *bound != texnum ) {
+		return false;
+	}
+	// a use, as Bind counts it
+	frameUsed = backEnd.frameCount;
+	bindCount++;
+	return true;
+}
+
