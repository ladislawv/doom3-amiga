 		idAsyncNetwork::RunFrame();
@@ -2774,6 +2782,7 @@ void idCommonLocal::SetMachineSpec( void ) {
 	}
 }
 
+#ifndef D3_SINGLE_TASK
 static unsigned int AsyncTimer(unsigned int interval, void *) {
 	common->Async();
 	Sys_TriggerEvent(TRIGGER_EVENT_ONE);
@@ -2790,6 +2799,7 @@ static unsigned int AsyncTimer(unsigned int interval, void *) {
 
