@@ -3041,10 +3051,12 @@ void idCommonLocal::Init( int argc, char **argv ) {
 		Sys_Error( "Error during initialization" );
 	}
 
+#ifndef D3_SINGLE_TASK
 	async_timer = SDL_AddTimer(USERCMD_MSEC, AsyncTimer, NULL);
 
