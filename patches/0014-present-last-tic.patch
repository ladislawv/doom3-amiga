+/*
+================
+idGameLocal::DeferPresent
+
+An entity's Present waits for the frame's last game tic (idEntity::DeferPresent).
+================
+*/
+void idGameLocal::DeferPresent( idEntity *ent ) {
+	idEntityPtr<idEntity> p;
+	p = ent;
+	deferredPresents.Append( p );
+}
+
+/*
+================
+idGameLocal::PresentDeferred
+
+On a tic after which the frame is drawn, after the entities' think: those whose
+Present waited and that have not presented since (their Think presents them as
+a rule), presented now. A Present done twice does nothing the second time
+(TH_UPDATEVISUALS cleared).
+================
+*/
+void idGameLocal::PresentDeferred( void ) {
+	int i;
+	if ( !deferredPresents.Num() ) {
+		return;
+	}
+	const bool more = com_moreTicsBeforeDraw;
+	com_moreTicsBeforeDraw = false;	// a skipped cinematic's tic: present for real
+	for ( i = 0; i < deferredPresents.Num(); i++ ) {
+		idEntity *ent = deferredPresents[i].GetEntity();
+		if ( ent && ( ent->thinkFlags & TH_UPDATEVISUALS ) ) {
+			ent->Present();
+		}
+	}
+	deferredPresents.SetNum( 0, false );
+	com_moreTicsBeforeDraw = more;
+}
