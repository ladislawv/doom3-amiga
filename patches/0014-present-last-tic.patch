+/*
+================
+idEntity::DeferPresent
+
+Port (com_presentLastTic): during a game tic that another tic follows before
+the next frame is drawn, an entity with visuals to present keeps
+TH_UPDATEVISUALS (so it stays active and presents on the frame's last tic)
+and is remembered, so that idGameLocal::PresentDeferred presents it on that
+tic should its Think not. Present and its overrides ask this first.
+================
+*/
+bool idEntity::DeferPresent( void ) {
+	if ( !com_moreTicsBeforeDraw || !( thinkFlags & TH_UPDATEVISUALS ) ) {
+		return false;
+	}
+	gameLocal.DeferPresent( this );
+	return true;
+}
