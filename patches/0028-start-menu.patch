+/*
+================
+Session_StartMenu_f
+
+port (patch 0028): the main menu as the game opens it at start-up when its
+command line carries no commands (idCommonLocal::Init). A command line with
++exec gets no menu; disconnect would also stop the (absent) session and
+unmute the sound system, which hung the A1200 about 20 s into the menu.
+================
+*/
+static void Session_StartMenu_f( const idCmdArgs &args ) {
+	sessLocal.StartMenu( true );
+}
