+/*
+=================
+R_CapViewLights
+
+Port (patch 0026, after ldhewm3-rearmed's 7f43e0d): keeps the r_maxLights most
+important of the view's lights. Ambient and fog lights come first; the others
+are ranked by the distance from the view to the light's volume (0 inside it)
+against the volume's size and the light's brightness (a light whose colour
+comes from its material counts as bright 1). The Vita's ranking took the
+centre's distance and lightRadius, which projected lights do not have: they
+counted as size 0 and went first. A light kept in the last frame scores
+r_maxLightsKeep times better, so lights near the limit do not flicker. The
+dropped ones leave the view's list and are marked out of view, so no
+interactions are made for them this frame.
+=================
+*/
+static void R_CapViewLights( int maxLights ) {
+	struct scored_t { float score; viewLight_t *vLight; };
+	idList<scored_t> lights;
+	viewLight_t *vLight;
+	const float keep = r_maxLightsKeep.GetFloat() > 1.0f ? r_maxLightsKeep.GetFloat() : 1.0f;
+
+	for ( vLight = tr.viewDef->viewLights; vLight; vLight = vLight->next ) {
+		scored_t s;
+		s.vLight = vLight;
+		if ( vLight->lightShader->IsAmbientLight() || vLight->lightShader->IsFogLight() ) {
+			s.score = -1.0f;
+		} else {
+			const idRenderLightLocal *light = vLight->lightDef;
+			const renderLight_t &parms = light->parms;
+			const idVec3 &view = tr.viewDef->renderView.vieworg;
+			idBounds b;
+			if ( light->frustumTris ) {
+				b = light->frustumTris->bounds;
+			} else {
+				b[0] = light->globalLightOrigin - parms.lightRadius;
+				b[1] = light->globalLightOrigin + parms.lightRadius;
+			}
+			// the squared distance from the view to the box, 0 inside it
+			float distSq = 0.0f;
+			for ( int k = 0; k < 3; k++ ) {
+				float d = view[k] < b[0][k] ? b[0][k] - view[k] : view[k] > b[1][k] ? view[k] - b[1][k] : 0.0f;
+				distSq += d * d;
+			}
+			idVec3 size = b[1] - b[0];
+			float volume = idMath::Fabs( size.x * size.y * size.z );
+			float brightness = parms.shaderParms[0] + parms.shaderParms[1] + parms.shaderParms[2];
+			if ( brightness <= 0.0f ) {
+				brightness = 1.0f;
+			}
+			s.score = ( distSq + 1.0f ) / ( volume * brightness + 1.0f );
+			if ( light->maxLightsFrame == tr.frameCount - 1 || light->maxLightsFrame == tr.frameCount ) {
+				s.score /= keep;	// kept last frame (or by an earlier view of this frame)
+			}
+		}
+		lights.Append( s );
+	}
+	if ( lights.Num() <= maxLights ) {
+		for ( int i = 0; i < lights.Num(); i++ ) {
+			lights[i].vLight->lightDef->maxLightsFrame = tr.frameCount;
+		}
+		return;
+	}
+	// insertion sort, lowest score (most important) first: a view has tens of lights
+	for ( int i = 1; i < lights.Num(); i++ ) {
+		scored_t s = lights[i];
+		int j = i - 1;
+		while ( j >= 0 && lights[j].score > s.score ) {
+			lights[j + 1] = lights[j];
+			j--;
+		}
+		lights[j + 1] = s;
+	}
+	tr.viewDef->viewLights = NULL;
+	for ( int i = lights.Num() - 1; i >= 0; i-- ) {
+		if ( i < maxLights ) {
+			lights[i].vLight->next = tr.viewDef->viewLights;
+			tr.viewDef->viewLights = lights[i].vLight;
+			lights[i].vLight->lightDef->maxLightsFrame = tr.frameCount;
+		} else {
+			lights[i].vLight->lightDef->viewCount = -1;
+		}
+	}
+}
