diff --git a/neo/renderer/tr_local.h b/neo/renderer/tr_local.h
index d41444fb..228ac203 100644
--- a/neo/renderer/tr_local.h
+++ b/neo/renderer/tr_local.h
@@ -1318,6 +1318,25 @@ void R_ReloadGLSLPrograms_f(const idCmdArgs &args);
 #define RB_NUM_STAGES 7
 extern double rb_stageMsec[RB_NUM_STAGES];
 
+// The front end's stages, summed until the benchmark clears them (tr_main.cpp,
+// patch 0015): of R_RenderView, the outermost view only, 0 view set-up, 1 the
+// visible lights and entities, 2 light surfaces, 3 model surfaces, 4 subviews,
+// 5 the rest; inside them, 6 dynamic model snapshots (InstantiateDynamicModel:
+// skinning, deforms), 7 interactions created (light triangles, shadow volumes),
+// 8 light triangles made on a later view; and of the model surfaces, 9 entity
+// scissors, 10 ambient draw surfaces, 11 active interactions added (with 7, 8);
+// of the active interactions, 12 the view frustum cull and shadow scissor.
+#define RF_NUM_STAGES 13
+extern double rf_stageMsec[RF_NUM_STAGES];
+// and counts, while rf_timeStages: 0 active interactions visited, 1 of them
+// culled or scissored by the view frustum (12), 2 light surfaces linked,
+// 3 shadow surfaces linked, 4 ambient draw surfaces
+#define RF_NUM_COUNTS 5
+extern int rf_count[RF_NUM_COUNTS];
+extern bool rf_timeStages;	// set while the benchmark counts: the timers read the clock (about 500 reads a frame)
+// a clock read for the front end's timers, 0 when they are off
+#define RF_NOW() ( rf_timeStages ? Sys_MillisecondsPrecise() : 0.0 )
+
 void RB_GLSL_PrepareShaders(void);
 void RB_GLSL_FillDepthBuffer(drawSurf_t **drawSurfs, int numDrawSurfs);
 void RB_GLSL_DrawInteractions(void);
