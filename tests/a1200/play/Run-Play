; Run-Play - Doom 3 port: play a map on the A1200. No benchmark, mouse look
; on; the game runs until the player quits it (console: quit). The port's
; settings: 20 game tics a second (HZ=), no vsync, precompressed textures, sound
; through AHI (the port's OpenAL subset; SOUND=0 for none).
;   CD to this directory, then:   Execute Run-Play
;   Another size:                  Execute Run-Play W=320 H=200
;   Another map:                   Execute Run-Play MAP=game/demo_mars_city1
;   No sound:                      Execute Run-Play SOUND=0
;   Another game rate:             Execute Run-Play HZ=30 (game tics a second; default 20)
;   Other game data:               Execute Run-Play DATA=<directory with demo/ or base/>
;   More console commands:         one line in dhewm3.args next to it
;   Settings:                      Execute Run-Play QUALITY=game (the game's own: it
;                                  detects "Ultra" here, from the memory); the default,
;                                  low, runs low.cfg (Doom 3's Low preset, and shadows,
;                                  post-process effects, decals, blood, muzzle flashes,
;                                  projectile lights, ejected shells off)
; Output goes to results/ (console log, memory before and after).
.key MAP/K,W/K,H/K,DATA/K,QUALITY/K,HZ/K,SOUND/K
.def MAP "game/demo_mc_underground"
.def W 640
.def H 480
.def DATA "Stuff:doom3"
.def QUALITY "low"
.def HZ 20
.def SOUND 1
.bra {
.ket }

FailAt 21
If NOT EXISTS dhewm3
  Echo "Please CD into the play directory first, then run:  Execute Run-Play"
  Quit 20
EndIf
MakeDir results >NIL:
Avail FLUSH >NIL:
Avail >results/avail-before.txt
List LIBS:ogles2#? >results/libs.txt
List libs >>results/libs.txt
Stack 9000000
Set args ""
If EXISTS dhewm3.args
  Set args `Type dhewm3.args`
EndIf
Set nosound 1
If {SOUND} EQ 1
  Set nosound 0
EndIf
Set quality ""
If EXISTS {QUALITY}.cfg
  ; the game finds it in its save directory (first in its search path)
  MakeDir save save/demo >NIL:
  Copy {QUALITY}.cfg save/demo/ QUIET
  Set quality "+exec {QUALITY}.cfg"
EndIf

Echo "Doom 3: {MAP} at {W}x{H}, {QUALITY} settings, {HZ} Hz; quit from the console (key above Tab) with: quit"
dhewm3 +set fs_basepath "{DATA}" +set s_noSound $nosound +set image_usePrecompressedTextures 1 +set r_fullscreen 1 +set r_mode -1 +set r_customWidth {W} +set r_customHeight {H} +set com_gameHz {HZ} +set r_swapInterval 0 $quality $args +map {MAP} >results/stdout.txt
Echo "exit code $RC" >>results/stdout.txt
Copy save/dhewm3log.txt results/ QUIET
Avail FLUSH >NIL:
Avail >results/avail-after.txt
