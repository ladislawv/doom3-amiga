+++ b/libSDL2-amigaos3-main/include/SDL_config_amigaos3.h
@@ -39,6 +39,7 @@
 
 /* C library features available in bebbo-gcc libnix */
 #define HAVE_STDARG_H   1
+#define HAVE_STDLIB_H   1 /* libnix and clib2 both have it; GCC 14+ refuses the implicit declarations without it */
 #define HAVE_STDDEF_H   1
 #define HAVE_STDINT_H   1
 
