     if (!data) return;
 
     DLOG("CloseDevice: dev_open=%d playing=%d", data->dev_open, data->playing);
+    if (data->errors || data->idle_waits)
+        SDL_Log("Paula audio: %lu requests handed back with an error (the first: io_Error %d), %lu waits with no device",
+                (unsigned long)data->errors, (int)data->first_error, (unsigned long)data->idle_waits);
 
     if (data->dev_open && data->req[0]) {
         if (data->req[1] && data->playing > 1) {
