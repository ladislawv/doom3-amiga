+/* WaitDevice (patch 0103): the thread always sleeps here, about a buffer's
+   playing time at least. A request audio.device hands back at once -- with
+   an error, e.g. its channels taken by a user of higher precedence
+   (ADIOERR_NOALLOCATION) -- or no device open let the audio thread loop
+   without sleeping at its priority (10, SDL's TIME_CRITICAL): the
+   application's own task (0) and everything between starved (Doom 3's main
+   menu hung, the Amiga's network with it, while the Workbench still took
+   clicks; doom3-amiga, 2026-10-22). Errors are counted and the first one is
+   reported when the device closes (from the application's task, not this
+   thread). */
 static void OS3PAULA_WaitDevice(_THIS)
 {
     struct OS3PaulaData *data = (struct OS3PaulaData *)_this->hidden;
+    struct IOAudio *req;
 
-    if (!data->dev_open || data->playing < 1)
+    if (!data->dev_open) {
+        data->idle_waits++;
+        Delay(data->ticks);
+        return;
+    }
+    if (data->playing < 1)
         return;
 
-    DLOG("WaitDevice: playing=%d cur=%d CheckIO...", data->playing, data->current);
-
-    if (!CheckIO((struct IORequest *)data->req[data->current])) {
-        DLOG("WaitDevice: not done, calling WaitIO...");
-        WaitIO((struct IORequest *)data->req[data->current]);
-        DLOG("WaitDevice: WaitIO returned");
-    } else {
-        DLOG("WaitDevice: already done");
+    req = data->req[data->current];
+    if (!CheckIO((struct IORequest *)req)) {
+        WaitIO((struct IORequest *)req);
+    }
+    if (req->ioa_Request.io_Error) {
+        if (!data->errors)
+            data->first_error = req->ioa_Request.io_Error;
+        data->errors++;
+        Delay(data->ticks);
     }
 }
 
