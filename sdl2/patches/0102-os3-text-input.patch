+/* Text input: SDL sends no SDL_TEXTINPUT on this driver otherwise, and SDL2
+   programs take typed text only from it (Doom 3's console, a game's name
+   entry). A key's press goes through the user's keymap (MapRawKey, with the
+   qualifiers and the previous keys for dead keys); its printable characters
+   (ISO 8859-1, as the Amiga's keymaps give them) go to SDL as UTF-8. Control
+   characters (Return, Tab, Backspace, Esc, Del, cursor keys) stay key events. */
+static void OS3_HandleText(UWORD code, UWORD qualifier, APTR prevkeys)
+{
+    struct InputEvent ie;
+    UBYTE  buf[16];
+    char   utf8[33];
+    LONG   n, i;
+    int    o = 0;
+
+    if ((code & AMIGA_KEY_UP) || !SDL_IsTextInputActive()) {
+        return;
+    }
+    if (!KeymapBase && !(KeymapBase = OpenLibrary((CONST_STRPTR)"keymap.library", 37))) {
+        return;
+    }
+    SDL_zero(ie);
+    ie.ie_Class        = IECLASS_RAWKEY;
+    ie.ie_Code         = code;
+    ie.ie_Qualifier    = qualifier;
+    ie.ie_EventAddress = prevkeys;
+    n = MapRawKey(&ie, (STRPTR)buf, sizeof(buf), NULL);
+    for (i = 0; i < n; i++) {
+        UBYTE c = buf[i];
+        if (c < 0x20 || c == 0x7f || (c >= 0x80 && c < 0xa0)) {
+            continue;
+        }
+        if (c < 0x80) {
+            utf8[o++] = (char)c;
+        } else {
+            utf8[o++] = (char)(0xc0 | (c >> 6));
+            utf8[o++] = (char)(0x80 | (c & 0x3f));
+        }
+    }
+    if (o > 0) {
+        utf8[o] = '\0';
+        SDL_SendKeyboardText(utf8);
+    }
+}
