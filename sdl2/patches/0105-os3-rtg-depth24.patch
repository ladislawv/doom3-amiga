+            SA_Exclusive,  TRUE,
+            SA_Draggable,  FALSE,
+            SA_AutoScroll, FALSE,
+            TAG_DONE
+        );
+    }
     if (!screen) {
         return SDL_SetError("OS3: OpenScreenTags failed for %dx%dx%d",
                             w, h, depth);
