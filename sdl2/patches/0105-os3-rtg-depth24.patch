diff --git a/libSDL2-amigaos3-main/src/video/amigaos3/SDL_os3video.c b/libSDL2-amigaos3-main/src/video/amigaos3/SDL_os3video.c
index 8bdf0f19..98fffa1f 100644
--- a/libSDL2-amigaos3-main/src/video/amigaos3/SDL_os3video.c
+++ b/libSDL2-amigaos3-main/src/video/amigaos3/SDL_os3video.c
@@ -480,6 +480,25 @@ static int OS3_SetDisplayMode(_THIS, SDL_VideoDisplay *display,
         SA_AutoScroll, FALSE,
         TAG_DONE
     );
+    /* Picasso96 (uaegfx under WinUAE among others) opens its 32-bit RTG modes
+     * only as depth 24 and refuses SA_Depth 32. The mode ID decides the pixel
+     * format, so the screen is the same 32-bit one; where depth 32 opens (Emu68's
+     * RTG on the PiStorm), nothing changes. Without this the full screen failed
+     * and SDL fell back to a window on the Workbench. */
+    if (!screen && depth == 32) {
+        screen = OpenScreenTags(NULL,
+            SA_Title,      (ULONG)"SDL",
+            SA_Quiet,      TRUE,
+            SA_ShowTitle,  FALSE,
+            SA_Depth,      24UL,
+            SA_DisplayID,  modeid,
+            SA_Type,       CUSTOMSCREEN,
+            SA_Exclusive,  TRUE,
+            SA_Draggable,  FALSE,
+            SA_AutoScroll, FALSE,
+            TAG_DONE
+        );
+    }
     if (!screen) {
         return SDL_SetError("OS3_SetDisplayMode: OpenScreenTags failed");
     }
